
MEMORY
{
   program (RX) : ORIGIN = 0, LENGTH = 0x4000
   data (!RX) : ORIGIN = 0x7E000, LENGTH = 0x2000
}
ENTRY(__start)
SECTIONS
{
  . = 0x0;
  .text : {
     /* the __start symbol has to come at address zero. */
     *crt0.o(.text*)
     _ctors_start = .;
     _init_array_start = .;
     KEEP(SORT(*.init_array))
     _ctors_end = .;
     _init_array_end = .;
     _dtors_start = .;
     _dtors_end = .;
     *(.text*)
  } > program
  .data : {
     *(.data*)
     *(.rodata*)
  } > data
  .comment : {
     *(.comment*)
  }
  .symtab : {
     *(.symtab)
  }
  .shstrtab : {
     *(.shstrtab)
  }
  .strtab : {
     *(.strtab)
  }
  .stack_sizes : {
     *(.stack_sizes)
  }

. = 0x70000;
_sp_start_value_DM_stack = .;
. += 0x800; /* stack */
/* No tile with memory exists to the south. */
. = 0x40000;
. += 0x10000;
. = 0x5C000;
A_L2L1_0_cons_buff_0 = .;
. += 0x1000;
. = 0x50800;
A_L2L1_0_cons_buff_1 = .;
. += 0x1000;
. = 0x5D000;
B_L2L1_0_cons_buff_0 = .;
. += 0x1000;
. = 0x51800;
B_L2L1_0_cons_buff_1 = .;
. += 0x1000;
. = 0x54000;
C_L1L2_0_buff_0 = .;
. += 0x4000;
. = 0x58000;
C_L1L2_0_buff_1 = .;
. += 0x4000;
. = 0x7C000;
A_L2L1_1_cons_buff_0 = .;
. += 0x1000;
. = 0x70800;
A_L2L1_1_cons_buff_1 = .;
. += 0x1000;
. = 0x7D000;
B_L2L1_1_cons_buff_0 = .;
. += 0x1000;
. = 0x71800;
B_L2L1_1_cons_buff_1 = .;
. += 0x1000;
. = 0x74000;
C_L1L2_1_buff_0 = .;
. += 0x4000;
. = 0x78000;
C_L1L2_1_buff_1 = .;
. += 0x4000;
  .bss : { *(.bss*) } > data
}
INPUT(/Storage/Cache/llama.cpp/experiments/xdna-v2/M512_K1024_N3072_C2/matmul_i8_i32.o)
PROVIDE(main = core_1_2);
