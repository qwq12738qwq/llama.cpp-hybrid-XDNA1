#version 450
// INT32 row-major GEMM: C = A x B, values are int8 stored in int32 buffers.
// A[height x kdim], B[kdim x width], C[height x width]
// Numerically identical to a device int8 x int8 -> int32 GEMM (exact integers).
layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout (std430, binding = 0) readonly buffer BufA { int a_data[]; };
layout (std430, binding = 1) readonly buffer BufB { int b_data[]; };
layout (std430, binding = 2) writeonly buffer BufC { int c_data[]; };

layout (push_constant) uniform PushBlock {
    uint width;
    uint height;
    uint k_dim;
};

void main() {
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= width || y >= height) {
        return;
    }
    int sum = 0;
    for (uint k = 0; k < k_dim; k++) {
        sum += a_data[y * k_dim + k] * b_data[k * width + x];
    }
    c_data[y * width + x] = sum;
}
