+        ggml_backend_buffer_t node_buffer = node->view_src ? node->view_src->buffer : node->buffer;
+        ggml_backend_buffer_type_t node_buft = node_buffer ? node_buffer->buft : NULL;
+        fprintf(stderr, "[SCHED-OWNERSHIP] node[%d] name=%s op=%s tensor=%p data=%p buffer=%p view_src=%p buft=%s usage=%d assigned=%d prev=%d\n",
