+// Phase 48: aggregate scheduler metrics for one graph compute, printed as a
+// single machine-readable line from ggml_backend_sched_synchronize(). Enabled
+// with GGML_SCHED_TRACE_STATS.
+//
+// Backend busy time is the interval from a backend's first outstanding submit
+// to the point where that backend is actually synchronized, so it includes
+// real GPU/NPU execution and not just command recording.
+#define GGML_SCHED_TRACE_MAX_IV 512
+
+struct ggml_sched_trace_iv {
+    uint64_t start;
+    uint64_t end;
+};
+
+struct ggml_sched_trace {
+    bool enabled;
+    bool dirty;
+    int  seq;
+
+    int  n_nodes;
+    int  n_nodes_gpu;
+    int  n_nodes_xdna;
+    int  n_nodes_cpu;
+    int  n_mm_gpu;
+    int  n_mm_xdna;
+    int  n_mm_cpu;
+
+    int    n_splits;
+    int    n_transitions;
+    int    n_copy_bufs;
+    int    n_copies;
+    size_t copy_bytes;
+
+    int    n_v2x; size_t b_v2x; double t_v2x;
+    int    n_x2v; size_t b_x2v; double t_x2v;
+    int    n_c2x; size_t b_c2x; double t_c2x;
+    int    n_x2c; size_t b_x2c; double t_x2c;
+
+    double t_alloc;
+    double t_submit;
+    double t_sync;
+    double t_wall;
+
+    int       n_iv[GGML_SCHED_MAX_BACKENDS];
+    uint64_t  iv_open[GGML_SCHED_MAX_BACKENDS];
+    double    busy_ms[GGML_SCHED_MAX_BACKENDS];
+    struct ggml_sched_trace_iv iv[GGML_SCHED_MAX_BACKENDS][GGML_SCHED_TRACE_MAX_IV];
+};
+
+static struct ggml_sched_trace g_sched_trace;
+
+static bool ggml_sched_trace_enabled() {
+    return getenv("GGML_SCHED_TRACE_STATS") != nullptr;
+}
+
+static void ggml_sched_trace_begin() {
+    if (!ggml_sched_trace_enabled()) {
+        g_sched_trace.enabled = false;
+        return;
+    }
+    g_sched_trace.enabled = true;
+    g_sched_trace.dirty   = true;
+    g_sched_trace.seq++;
+    g_sched_trace.n_nodes = 0;
+    g_sched_trace.n_nodes_gpu   = 0;
+    g_sched_trace.n_nodes_xdna = 0;
+    g_sched_trace.n_nodes_cpu  = 0;
+    g_sched_trace.n_mm_gpu   = 0;
+    g_sched_trace.n_mm_xdna  = 0;
+    g_sched_trace.n_mm_cpu   = 0;
+    g_sched_trace.n_splits   = 0;
+    g_sched_trace.n_transitions = 0;
+    g_sched_trace.n_copies   = 0;
+    g_sched_trace.n_copy_bufs = 0;
+    g_sched_trace.copy_bytes = 0;
+    g_sched_trace.n_v2x = 0; g_sched_trace.b_v2x = 0; g_sched_trace.t_v2x = 0;
+    g_sched_trace.n_x2v = 0; g_sched_trace.b_x2v = 0; g_sched_trace.t_x2v = 0;
+    g_sched_trace.n_c2x = 0; g_sched_trace.b_c2x = 0; g_sched_trace.t_c2x = 0;
+    g_sched_trace.n_x2c = 0; g_sched_trace.b_x2c = 0; g_sched_trace.t_x2c = 0;
+    g_sched_trace.t_alloc  = 0;
+    g_sched_trace.t_submit = 0;
+    g_sched_trace.t_sync   = 0;
+    g_sched_trace.t_wall   = 0;
+    for (int b = 0; b < GGML_SCHED_MAX_BACKENDS; b++) {
+        g_sched_trace.n_iv[b]    = 0;
+        g_sched_trace.iv_open[b] = 0;
+        g_sched_trace.busy_ms[b] = 0;
+    }
