+
+static void ggml_sched_trace_busy_open(int backend_id, uint64_t now) {
+    if (!g_sched_trace.enabled || backend_id < 0 || backend_id >= GGML_SCHED_MAX_BACKENDS) {
+        return;
+    }
+    if (g_sched_trace.iv_open[backend_id] == 0) {
+        g_sched_trace.iv_open[backend_id] = now;
+    }
+}
+
+static void ggml_sched_trace_busy_close(int backend_id, uint64_t now) {
+    if (!g_sched_trace.enabled || backend_id < 0 || backend_id >= GGML_SCHED_MAX_BACKENDS) {
+        return;
+    }
+    const uint64_t start = g_sched_trace.iv_open[backend_id];
+    g_sched_trace.iv_open[backend_id] = 0;
+    if (start == 0 || now <= start) {
+        return;
+    }
+    const double ms = (now - start) / 1e6;
+    g_sched_trace.busy_ms[backend_id] += ms;
+    if (g_sched_trace.n_iv[backend_id] < GGML_SCHED_TRACE_MAX_IV) {
+        g_sched_trace.iv[backend_id][g_sched_trace.n_iv[backend_id]++] = { start, now };
+    }
+}
+
+// intersection of two sorted disjoint interval lists
+static double ggml_sched_trace_overlap(int a, int b) {
+    double total = 0;
+    int i = 0, j = 0;
+    while (i < g_sched_trace.n_iv[a] && j < g_sched_trace.n_iv[b]) {
+        const uint64_t lo = g_sched_trace.iv[a][i].start > g_sched_trace.iv[b][j].start ? g_sched_trace.iv[a][i].start : g_sched_trace.iv[b][j].start;
+        const uint64_t hi = g_sched_trace.iv[a][i].end   < g_sched_trace.iv[b][j].end   ? g_sched_trace.iv[a][i].end   : g_sched_trace.iv[b][j].end;
+        if (hi > lo) {
+            total += (hi - lo) / 1e6;
+        }
+        if (g_sched_trace.iv[a][i].end < g_sched_trace.iv[b][j].end) {
+            i++;
+        } else {
+            j++;
+        }
+    }
+    return total;
+}
+
+static void ggml_sched_trace_end(ggml_backend_sched_t sched, uint64_t now) {
+    if (!g_sched_trace.enabled || !g_sched_trace.dirty) {
+        return;
+    }
+    for (int b = 0; b < GGML_SCHED_MAX_BACKENDS; b++) {
+        ggml_sched_trace_busy_close(b, now);
+    }
+    g_sched_trace.dirty = false;
+
+    double acc_busy = 0;
+    for (int b = 0; b < sched->n_backends; b++) {
+        acc_busy += g_sched_trace.busy_ms[b];
+    }
+
+    // Only one pair of backends can be active at a time here, so the largest
+    // pairwise intersection is the honest overlap figure.
+    double best_pair = 0;
+    double pair_sum = 0;
+    int best_a = -1, best_b = -1;
+    for (int a = 0; a < sched->n_backends; a++) {
+        for (int b = a + 1; b < sched->n_backends; b++) {
+            if (g_sched_trace.n_iv[a] == 0 || g_sched_trace.n_iv[b] == 0) {
+                continue;
+            }
+            const double o = ggml_sched_trace_overlap(a, b);
+            pair_sum += o;
+            if (o > best_pair) {
+                best_pair = o;
+                best_a = a;
+                best_b = b;
+            }
+        }
+    }
+
+    fprintf(stderr,
+            "[SCHED-SUMMARY] seq=%d n_nodes=%d n_nodes_gpu=%d n_nodes_xdna=%d n_nodes_cpu=%d "
+            "n_mm_gpu=%d n_mm_xdna=%d n_mm_cpu=%d "
+            "n_splits=%d n_transitions=%d n_copies=%d n_copy_bufs=%d copy_bytes=%zu "
+            "v2x_n=%d v2x_bytes=%zu v2x_ms=%.3f x2v_n=%d x2v_bytes=%zu x2v_ms=%.3f "
+            "c2x_n=%d c2x_bytes=%zu c2x_ms=%.3f x2c_n=%d x2c_bytes=%zu x2c_ms=%.3f "
+            "alloc_ms=%.3f submit_ms=%.3f sync_ms=%.3f wall_ms=%.3f "
+            "acc_busy_ms=%.3f overlap_ms=%.3f overlap_pair_sum_ms=%.3f overlap_pair=%s/%s "
+            "acc_busy_pct=%.1f\n",
+            g_sched_trace.seq, g_sched_trace.n_nodes, g_sched_trace.n_nodes_gpu, g_sched_trace.n_nodes_xdna,
+            g_sched_trace.n_nodes_cpu, g_sched_trace.n_mm_gpu, g_sched_trace.n_mm_xdna, g_sched_trace.n_mm_cpu,
+            g_sched_trace.n_splits, g_sched_trace.n_transitions, g_sched_trace.n_copies,
+            g_sched_trace.n_copy_bufs, g_sched_trace.copy_bytes,
+            g_sched_trace.n_v2x, g_sched_trace.b_v2x, g_sched_trace.t_v2x,
+            g_sched_trace.n_x2v, g_sched_trace.b_x2v, g_sched_trace.t_x2v,
+            g_sched_trace.n_c2x, g_sched_trace.b_c2x, g_sched_trace.t_c2x,
+            g_sched_trace.n_x2c, g_sched_trace.b_x2c, g_sched_trace.t_x2c,
+            g_sched_trace.t_alloc, g_sched_trace.t_submit, g_sched_trace.t_sync, g_sched_trace.t_wall,
+            acc_busy, best_pair, pair_sum,
+            best_a >= 0 ? ggml_backend_name(sched->backends[best_a]) : "-",
+            best_b >= 0 ? ggml_backend_name(sched->backends[best_b]) : "-",
+            g_sched_trace.t_wall > 0 ? 100.0 * acc_busy / g_sched_trace.t_wall : 0.0);
+}
