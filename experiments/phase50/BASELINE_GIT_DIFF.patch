+static ggml_vk_busy vk_busy;
+
 static void ggml_backend_vk_synchronize(ggml_backend_t backend) {
     VK_LOG_DEBUG("ggml_backend_vk_synchronize()");
     ggml_backend_vk_context * ctx = (ggml_backend_vk_context *)backend->context;
 
+    const bool trace = getenv("GGML_SCHED_TRACE_STATS") != nullptr;
+    const uint64_t sync_begin = trace ? ggml_time_ns() : 0;
+
     ggml_vk_synchronize(ctx);
 
     ggml_vk_graph_cleanup(ctx);
+
+    if (trace && vk_busy.open_ns != 0) {
+        const uint64_t sync_end = ggml_time_ns();
+        vk_busy.busy_ms += (sync_end - vk_busy.open_ns) / 1e6;
+        vk_busy.n_sync++;
+        fprintf(stderr, "[VK-SUMMARY] busy_ms=%.3f submit_ms=%.3f sync_ms=%.3f n_submit=%d n_sync=%d\n",
+                vk_busy.busy_ms, vk_busy.submit_ms, (sync_end - sync_begin) / 1e6, vk_busy.n_submit, vk_busy.n_sync);
+        vk_busy = {};
+    }
 }
 
