+    if (!device->external_memory_host) {
+        GGML_LOG_ERROR("ggml_vulkan: host-output buffer type requires VK_EXT_external_memory_host\n");
+        return nullptr;
+    }
+    if (size == 0) {
+        return nullptr;
+    }
+
+    size_t align = device->min_imported_host_pointer_alignment;
+    if (align == 0) {
+        align = 4096;
+    }
+    size_t alloc_size = (size + align - 1) & ~(align - 1);
+
+    void * host_ptr = nullptr;
+    if (posix_memalign(&host_ptr, align, alloc_size) != 0) {
+        return nullptr;
+    }
+    memset(host_ptr, 0, alloc_size);
+
+    vk_buffer buf;
+    try {
+        buf = ggml_vk_create_buffer(device, alloc_size,
+            { vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent | vk::MemoryPropertyFlagBits::eHostCached,
+              vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent },
+            host_ptr);
+    } catch (const vk::SystemError & e) {
+        GGML_LOG_WARN("ggml_vulkan: host-output import failed (%s)\n", e.what());
+        free(host_ptr);
+        return nullptr;
+    }
+    if (!buf) {
+        free(host_ptr);
+        return nullptr;
+    }
+
+    ggml_backend_vk_buffer_context * bufctx = new ggml_backend_vk_buffer_context(device, std::move(buf), ctx->name);
+    bufctx->host_ptr = host_ptr;
+
+    return ggml_backend_buffer_init(buft, ggml_backend_vk_host_output_buffer_interface, bufctx, size);
+}
