+// Phase 48: exact GPU busy accounting. Vulkan submits asynchronously, so busy
+// runs from the first graph_compute until the synchronize that retires it.
+struct ggml_vk_busy {
+    uint64_t open_ns = 0;
+    double busy_ms = 0;
+    double submit_ms = 0;
+    int n_submit = 0;
+    int n_sync = 0;
+};
