+// Phase 49: report how every FFN GEMM ended up on a backend. The scheduler's
+// choice is a function of op support, the offload claim, the weight buffer and
+// the view source, so print all of them next to the final assignment.
+static void ggml_backend_sched_trace_ffn_assignment(ggml_backend_sched_t sched, struct ggml_cgraph * graph) {
+    if (getenv("GGML_SCHED_TRACE_FFN_ASSIGN") == nullptr) {
+        return;
+    }
+    for (int i = 0; i < graph->n_nodes; i++) {
+        struct ggml_tensor * node = graph->nodes[i];
+        if (node->op != GGML_OP_MUL_MAT || node->src[0] == nullptr) {
+            continue;
+        }
+        const char * wname = node->src[0]->name;
+        if (!strstr(wname, "ffn_gate") && !strstr(wname, "ffn_up") && !strstr(wname, "ffn_down")) {
+            continue;
+        }
+        const int layer_id = sched->hv_tensor_backend_ids[hash_id(node)];
+        const int w_id = sched->hv_tensor_backend_ids[hash_id(node->src[0])];
+        const int a_id = node->src[1] ? sched->hv_tensor_backend_ids[hash_id(node->src[1])] : -1;
+        const int v_id = node->view_src ? sched->hv_tensor_backend_ids[hash_id(node->view_src)] : -1;
+
+        auto name_of = [&](int id) -> const char * {
+            return id >= 0 && id < sched->n_backends ? ggml_backend_name(sched->backends[id]) : "(none)";
+        };
+        auto buft_of = [&](const struct ggml_tensor * t) -> const char * {
+            const struct ggml_tensor * r = t ? (t->view_src ? t->view_src : t) : nullptr;
+            if (!r || !r->buffer) return "(null)";
+            return ggml_backend_buffer_name(r->buffer);
+        };
+        auto usage_of = [&](const struct ggml_tensor * t) -> int {
+            const struct ggml_tensor * r = t ? (t->view_src ? t->view_src : t) : nullptr;
+            if (!r || !r->buffer) return -1;
+            return (int) ggml_backend_buffer_get_usage(r->buffer);
+        };
+        // same predicates the assignment consults, evaluated at report time
+        int layer = -1;
+        if (const char * blk = strstr(wname, "blk.")) {
+            sscanf(blk + 4, "%d", &layer);
+        }
+        // replicate the claim loop: first WEIGHTS src selects wbuft, backends
+        // owning it are skipped, first remaining supporter with offload wins
+        ggml_backend_buffer_type_t wbuft = NULL;
+        for (int i = 0; i < GGML_MAX_SRC; i++) {
+            const struct ggml_tensor * src = node->src[i];
+            if (src && src->buffer && src->buffer->usage == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                wbuft = src->buffer->buft;
+                break;
+            }
+        }
+        int claim_winner = -1;
+        if (sched->op_offload) {
+            for (int b = 0; b < sched->n_backends - 1; b++) {
+                if (sched->bufts[b] == wbuft) {
+                    continue;
+                }
+                if (ggml_backend_supports_op(sched->backends[b], node) && ggml_backend_offload_op(sched->backends[b], node)) {
+                    claim_winner = b;
+                    break;
+                }
+            }
+        }
+        char supoff[GGML_SCHED_MAX_BACKENDS * 8 + 1] = {};
+        for (int b = 0; b < sched->n_backends && b < GGML_SCHED_MAX_BACKENDS; b++) {
+            const bool sup = ggml_backend_supports_op(sched->backends[b], node);
+            const bool off = sup && ggml_backend_offload_op(sched->backends[b], node);
+            char * p = supoff + strlen(supoff);
+            snprintf(p, sizeof(supoff) - strlen(supoff), "%d:%c%c ", b, sup ? 'S' : '-', off ? 'O' : '-');
+        }
+        const char * reason = "unassigned";
+        if (layer_id == claim_winner && claim_winner != -1) {
+            reason = "op_offload_claim";
+        } else if (w_id == layer_id && w_id != -1) {
+            reason = "weight_buffer";
+        } else if (layer_id != -1) {
+            reason = "first_supporting";
+        }
+        fprintf(stderr,
+                "[FFN-ASSIGN] layer=%d op=%s M=%lld K=%lld N=%lld weight=%s:%s wbuft=%s wusage=%d activation=%s:%s abuft=%s ausage=%d view=%s:%s "
+                "supoff={%s} claim=%d assigned=%s:%d reason=%s\n",
+                layer, wname, (long long) node->src[1]->ne[1], (long long) node->src[0]->ne[0], (long long) node->src[0]->ne[1],
+                wname, name_of(w_id), buft_of(node->src[0]), usage_of(node->src[0]),
+                node->src[1]->name, name_of(a_id), buft_of(node->src[1]), usage_of(node->src[1]),
+                node->view_src ? node->view_src->name : "(none)", name_of(v_id),
+                supoff, claim_winner, name_of(layer_id), layer_id, reason);
+    }
+}
